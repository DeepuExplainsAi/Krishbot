{
  "name": "krishbot",
  "productName": "Krishbot",
  "version": "1.0.0",
  "description": "Krishbot: your own AI agents on your own computer.",
  "main": "main.cjs", "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Krishbot",
  "scripts": {
    "start": "electron .",
    "serve": "node src/server.js",
    "icon": "node build/icon.mjs",
    "dist": "npm run icon && electron-builder --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.krishbot.desktop",
    "productName": "Krishbot",
    "files": ["main.cjs", "src/**", "public/**", "package.json", "build/icon.png"],
    "directories": { "buildResources": "build", "output": "release" },
    "linux": { "target": ["AppImage"], "category": "Utility", "artifactName": "Krishbot-${version}-linux-x64.${ext}" },
    "win": { "target": ["portable"], "artifactName": "Krishbot-${version}-windows-x64.${ext}" },
    "mac": { "target": ["dmg"], "identity": null, "category": "public.app-category.productivity", "artifactName": "Krishbot-${version}-mac-${arch}.${ext}" }
  }
}
