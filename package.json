{
  "name": "krishbot",
  "productName": "Krishbot",
  "version": "1.0.0",
  "description": "Krishbot: your own AI agents on your own computer.",
  "main": "main.cjs",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=22.13" },
  "author": "Krishbot",
  "scripts": {
    "start": "npm run build:server && electron .",
    "serve": "node server/dist/index.js",
    "dev": "tsx watch server/src/index.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "icon": "node build/icon.mjs",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "build": "npm run build:server && npm run build:web",
    "dist": "npm run build && npm run icon && electron-builder --publish never"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "croner": "^11.0.0",
    "hono": "^4.13.17",
    "openai": "^7.53.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "app.krishbot.desktop",
    "productName": "Krishbot",
    "files": [
      "main.cjs",
      "server/dist/**",
      "web/dist/**",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Krishbot-${version}-linux-x64.${ext}"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Krishbot-${version}-windows-x64.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "Krishbot-${version}-mac-${arch}.${ext}"
    },
    "asar": false,
    "npmRebuild": false
  }
}