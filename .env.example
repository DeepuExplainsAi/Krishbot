# Optional. Krishbot works without a .env file; everything below has a default.
# Copy to .env only to change something.

PORT=8787
# HOST=127.0.0.1                  # the app only listens on this computer
# KRISHBOT_DATA=~/.krishbot       # database, library files and the secret file
# DB_PATH=                        # default: <KRISHBOT_DATA>/krishbot.db

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # the gateway of the first bot
# HERMES_HOME_PRIMARY=~/.hermes
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=<KRISHBOT_DATA>/engines
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787
# EXTRA_MCP_SERVERS=              # JSON object of mcp_servers entries every extra bot gets
# PRIMARY_BOT_NAME=Krish
# PRIMARY_BOT_LABEL=Chief of Staff
# MAX_BOTS=50

# ---- voice and X research: set the key in Settings -> General (or here) ----
# XAI_API_KEY=
# XAI_VOICE_MODEL=
# XAI_STT_MODEL=
