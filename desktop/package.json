{
  "name": "krishbot-desktop",
  "productName": "Krishbot",
  "version": "0.1.0",
  "description": "Krishbot desktop app",
  "main": "main.js",
  "author": "DeepuExplainsAi",
  "license": "MIT",
  "scripts": {
    "icon": "node scripts/icon.mjs",
    "dist": "npm run icon && electron-builder --publish never"
  },
  "dependencies": {
    "@composio/core": "^0.28.0",
    "@composio/openai": "^0.13.0",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "croner": "^11.0.0",
    "hono": "^4.13.17",
    "openai": "^7.53.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.deepuexplainsai.krishbot",
    "productName": "Krishbot",
    "asar": false,
    "npmRebuild": true,
    "files": ["main.js", "setup.html", "preload.js", "package.json", "server/dist/**", "server/box/**", "web/dist/**", "app-type.json"],
    "directories": { "buildResources": "build", "output": "release" },
    "linux": { "target": ["AppImage"], "category": "Utility", "artifactName": "Krishbot-${version}-linux-x64.${ext}" },
    "win": { "target": ["portable"], "artifactName": "Krishbot-${version}-windows-x64.${ext}" },
    "mac": { "target": ["dmg"], "category": "public.app-category.productivity", "identity": null, "artifactName": "Krishbot-${version}-mac-${arch}.${ext}" }
  }
}
